// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// SVP+VWAP Strategy V2 with LVN Expansion
// Session Volume Profile + VWAP Combined Strategy

//@version=6
strategy("SVP + VWAP Strategy V2", shorttitle="SVP+VWAP", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=25, commission_type=strategy.commission.cash_per_contract, commission_value=20, slippage=1, pyramiding=0)

// ============================================================================
// INPUTS
// ============================================================================

// Session Settings
grp_session = "Session Settings"
sessionLookback = input.int(75, "Session Lookback (bars)", minval=20, maxval=200, group=grp_session)
numBins = input.int(50, "Number of Price Bins", minval=10, maxval=100, group=grp_session)
valueAreaPct = input.float(0.70, "Value Area %", minval=0.5, maxval=0.9, step=0.05, group=grp_session)

// VWAP Settings
grp_vwap = "VWAP Settings"
vwapBandInner = input.float(1.0, "Inner Band StdDev", minval=0.5, maxval=3.0, step=0.1, group=grp_vwap)
vwapBandOuter = input.float(2.0, "Outer Band StdDev", minval=1.0, maxval=4.0, step=0.1, group=grp_vwap)

// Signal Settings
grp_signal = "Signal Settings"
volumeConfirmMult = input.float(1.2, "Volume Confirm Multiplier", minval=1.0, maxval=2.0, step=0.1, group=grp_signal)
lvnVolumeSurge = input.float(1.5, "LVN Volume Surge Multiplier", minval=1.2, maxval=3.0, step=0.1, group=grp_signal)
pocBreakBars = input.int(3, "POC Break Confirmation Bars", minval=1, maxval=5, group=grp_signal)
pocMigrateSessions = input.int(3, "POC Migration Sessions", minval=2, maxval=5, group=grp_signal)
pocMigrateThreshold = input.float(0.002, "POC Migration Threshold %", minval=0.001, maxval=0.01, step=0.001, group=grp_signal)
lvnThreshold = input.float(0.3, "LVN Threshold", minval=0.1, maxval=0.5, step=0.05, group=grp_signal)

// LVN Expansion Settings
grp_lvn = "LVN Expansion Settings"
lvnExpansionBars = input.int(5, "LVN Expansion Check Bars", minval=2, maxval=10, group=grp_lvn, tooltip="Number of bars to check for price expansion after LVN entry")
lvnExpansionMinMove = input.float(0.5, "LVN Min Expansion % Move", minval=0.2, maxval=2.0, step=0.1, group=grp_lvn, tooltip="Minimum % move expected through LVN zone")
showLVNExpansion = input.bool(true, "Highlight LVN Expansion", group=grp_lvn)

// Risk Management
grp_risk = "Risk Management"
useATRSL = input.bool(true, "Use ATR Stop Loss", group=grp_risk)
atrPeriod = input.int(14, "ATR Period", minval=5, maxval=30, group=grp_risk)
atrMultiplier = input.float(2.0, "ATR Multiplier", minval=1.0, maxval=4.0, step=0.1, group=grp_risk)
fixedSLPoints = input.float(50.0, "Fixed SL Points (if not ATR)", minval=10, maxval=200, group=grp_risk)
tpRRRatio = input.float(2.0, "Take Profit R:R Ratio", minval=1.0, maxval=5.0, step=0.5, group=grp_risk)

// Trailing Stop
grp_trail = "Trailing Stop"
trailMode = input.string("Stepped", "Trailing Mode", options=["None", "Breakeven", "Stepped"], group=grp_trail)
// Stepped milestones: at Nx risk profit, lock in X% of profit
trail1ProfitMult = input.float(1.0, "Milestone 1: Profit (x risk)", minval=0.5, maxval=2.0, step=0.1, group=grp_trail, tooltip="Move SL when profit reaches this multiple of risk")
trail1LockMult = input.float(0.0, "Milestone 1: Lock (x risk)", minval=0.0, maxval=1.0, step=0.1, group=grp_trail, tooltip="Lock in this multiple of risk as profit (0 = breakeven)")
trail2ProfitMult = input.float(1.5, "Milestone 2: Profit (x risk)", minval=1.0, maxval=3.0, step=0.1, group=grp_trail)
trail2LockMult = input.float(0.5, "Milestone 2: Lock (x risk)", minval=0.0, maxval=1.5, step=0.1, group=grp_trail)
trail3ProfitMult = input.float(2.0, "Milestone 3: Profit (x risk)", minval=1.5, maxval=4.0, step=0.1, group=grp_trail)
trail3LockMult = input.float(1.0, "Milestone 3: Lock (x risk)", minval=0.5, maxval=2.0, step=0.1, group=grp_trail)

// Display Settings
grp_display = "Display Settings"
showVWAP = input.bool(true, "Show VWAP", group=grp_display)
showVWAPBands = input.bool(true, "Show VWAP Bands", group=grp_display)
showSVPLevels = input.bool(true, "Show POC/VAH/VAL", group=grp_display)
showSignals = input.bool(true, "Show Trade Signals", group=grp_display)
showLVNZones = input.bool(true, "Show LVN Zones", group=grp_display)

// Colors
colPOC = color.orange
colVAH = color.red
colVAL = color.green
colVWAP = color.blue
colBullish = color.lime
colBearish = color.red
colLVN = color.purple

// ============================================================================
// VWAP CALCULATION
// ============================================================================

typicalPrice = (high + low + close) / 3
vol = volume == 0 ? 1 : volume
tpVolume = typicalPrice * vol

rollingTPVol = ta.sma(tpVolume, sessionLookback) * sessionLookback
rollingVol = ta.sma(vol, sessionLookback) * sessionLookback
vwapLine = rollingTPVol / rollingVol

sqDiff = math.pow(typicalPrice - vwapLine, 2) * vol
rollingSqDiff = ta.sma(sqDiff, sessionLookback) * sessionLookback
variance = rollingSqDiff / rollingVol
vwapStd = math.sqrt(variance)

vwapUpperInner = vwapLine + vwapBandInner * vwapStd
vwapUpperOuter = vwapLine + vwapBandOuter * vwapStd
vwapLowerInner = vwapLine - vwapBandInner * vwapStd
vwapLowerOuter = vwapLine - vwapBandOuter * vwapStd

// ============================================================================
// SESSION VOLUME PROFILE
// ============================================================================

sessionHigh = ta.highest(high, sessionLookback)
sessionLow = ta.lowest(low, sessionLookback)
sessionRange = sessionHigh - sessionLow

var float sumVTP = 0.0
var float sumVol = 0.0

sumVTP := 0.0
sumVol := 0.0
for i = 0 to sessionLookback - 1
    sumVTP := sumVTP + typicalPrice[i] * volume[i]
    sumVol := sumVol + volume[i]

poc = sumVol > 0 ? sumVTP / sumVol : close

vaRange = sessionRange * (1 - valueAreaPct) / 2
vah = math.min(poc + vaRange + (sessionRange * 0.15), sessionHigh)
val_ = math.max(poc - vaRange - (sessionRange * 0.15), sessionLow)

// ============================================================================
// POC MIGRATION
// ============================================================================

sessionStep = math.max(1, sessionLookback / 2)
prevPOC = sumVol > 0 ? ta.valuewhen(bar_index % int(sessionStep) == 0, poc, pocMigrateSessions - 1) : poc
pocShift = prevPOC > 0 ? (poc - prevPOC) / prevPOC : 0.0
pocMigrateDir = pocShift > pocMigrateThreshold ? 1 : pocShift < -pocMigrateThreshold ? -1 : 0

// ============================================================================
// LVN DETECTION & EXPANSION TRACKING
// ============================================================================

avgVolume = ta.sma(volume, sessionLookback)
localVolume = ta.sma(volume, 5)
isLVN = localVolume < avgVolume * lvnThreshold

// LVN zone boundaries
var float lvnZoneHigh = na
var float lvnZoneLow = na
var int lvnEntryBar = na
var int lvnDirection = 0  // 1 = bullish entry, -1 = bearish entry
var float lvnEntryPrice = na

// Track LVN expansion
var bool inLVNExpansion = false
var float lvnExpansionTarget = na

// Detect LVN entry
volSurge = volume > avgVolume * lvnVolumeSurge
prevClose = close[1]

// Store LVN zone when detected
if isLVN
    lvnZoneHigh := high
    lvnZoneLow := low

// LVN Breakout Entry Detection
lvnBreakUp = false
lvnBreakDown = false

if volSurge and not na(lvnZoneLow[1]) and isLVN[1]
    // Bullish: price enters LVN from below
    if prevClose < lvnZoneLow[1] and close >= lvnZoneLow[1]
        lvnBreakUp := true
        lvnEntryBar := bar_index
        lvnDirection := 1
        lvnEntryPrice := close
        inLVNExpansion := true
        // Target: other side of LVN zone + expected expansion
        lvnExpansionTarget := lvnZoneHigh[1] * (1 + lvnExpansionMinMove / 100)

    // Bearish: price enters LVN from above
    if prevClose > lvnZoneHigh[1] and close <= lvnZoneHigh[1]
        lvnBreakDown := true
        lvnEntryBar := bar_index
        lvnDirection := -1
        lvnEntryPrice := close
        inLVNExpansion := true
        // Target: other side of LVN zone - expected expansion
        lvnExpansionTarget := lvnZoneLow[1] * (1 - lvnExpansionMinMove / 100)

// Track LVN Expansion Progress
var bool lvnExpansionSuccess = false
var bool lvnExpansionFailed = false

if inLVNExpansion
    barsInExpansion = bar_index - lvnEntryBar

    // Check if expansion succeeded
    if lvnDirection == 1 and high >= lvnExpansionTarget
        lvnExpansionSuccess := true
        inLVNExpansion := false
    else if lvnDirection == (-1) and low <= lvnExpansionTarget
        lvnExpansionSuccess := true
        inLVNExpansion := false

    // Check if expansion failed (exceeded time or reversed)
    if barsInExpansion >= lvnExpansionBars
        if lvnDirection == 1 and close < lvnEntryPrice
            lvnExpansionFailed := true
        else if lvnDirection == (-1) and close > lvnEntryPrice
            lvnExpansionFailed := true
        inLVNExpansion := false

// Reset flags
if lvnExpansionSuccess[1]
    lvnExpansionSuccess := false
if lvnExpansionFailed[1]
    lvnExpansionFailed := false

// ============================================================================
// VOLUME CONFIRMATION
// ============================================================================

volConfirm = volume > avgVolume * volumeConfirmMult

// ============================================================================
// BARS TRACKING
// ============================================================================

barsAbovePOC = ta.barssince(close <= poc)
barsBelowPOC = ta.barssince(close >= poc)
barsAboveVAH = ta.barssince(close <= vah)
barsBelowVAL = ta.barssince(close >= val_)

// ============================================================================
// SIGNAL GENERATION
// ============================================================================

var int signal = 0
var string signalType = ""
var int signalStrength = 0
var string tradeInstrument = ""

prevVAH = vah[1]
prevVAL = val_[1]
prevPOCVal = poc[1]

// V2 Advanced Signals
vahBreakout = prevClose <= prevVAH and close > vah
valBreakout = prevClose >= prevVAL and close < val_
pocMigrateUp = pocMigrateDir == 1
pocMigrateDown = pocMigrateDir == (-1)

// V1 Basic Signals with trend filters
pocDir = pocMigrateDir

valBounce = low <= val_ and close > val_ and pocDir >= 0
vwapBounce = low <= vwapLowerInner and close > vwapLowerInner and pocDir >= 0  // Trend filter
pocBreakUp = barsAbovePOC >= pocBreakBars and prevClose <= prevPOCVal

vahReject = high >= vah and close < vah and pocDir <= 0
vwapReject = high >= vwapUpperInner and close < vwapUpperInner and pocDir <= 0
pocBreakDown = barsBelowPOC >= pocBreakBars and prevClose >= prevPOCVal

// Signal Priority
signal := 0
signalType := ""
signalStrength := 0
tradeInstrument := ""

// BULLISH
if vahBreakout and pocMigrateUp
    signal := 1
    signalType := "VAH+POC_UP"
    tradeInstrument := "CALL"
    signalStrength := 4
else if lvnBreakUp
    signal := 1
    signalType := "LVN_EXP_UP"
    tradeInstrument := "CALL"
    signalStrength := 4
else if vahBreakout and volConfirm
    signal := 1
    signalType := "VAH_BRK"
    tradeInstrument := "CALL"
    signalStrength := 3
else if pocMigrateUp and volConfirm
    signal := 1
    signalType := "POC_UP"
    tradeInstrument := "CALL"
    signalStrength := 2
else if valBounce or vwapBounce or pocBreakUp
    signal := 1
    signalStrength := (valBounce ? 1 : 0) + (vwapBounce ? 1 : 0) + (pocBreakUp ? 1 : 0) + (volConfirm ? 1 : 0)
    signalType := valBounce ? "VAL_B" : vwapBounce ? "VWAP_B" : "POC_BRK_UP"
    tradeInstrument := "CALL"

// BEARISH
if signal == 0
    if valBreakout and pocMigrateDown
        signal := -1
        signalType := "VAL+POC_DN"
        tradeInstrument := "PUT"
        signalStrength := 4
    else if lvnBreakDown
        signal := -1
        signalType := "LVN_EXP_DN"
        tradeInstrument := "PUT"
        signalStrength := 4
    else if valBreakout and volConfirm
        signal := -1
        signalType := "VAL_BRK"
        tradeInstrument := "PUT"
        signalStrength := 3
    else if pocMigrateDown and volConfirm
        signal := -1
        signalType := "POC_DN"
        tradeInstrument := "PUT"
        signalStrength := 2
    else if vahReject or vwapReject or pocBreakDown
        signal := -1
        signalStrength := (vahReject ? 1 : 0) + (vwapReject ? 1 : 0) + (pocBreakDown ? 1 : 0) + (volConfirm ? 1 : 0)
        signalType := vahReject ? "VAH_R" : vwapReject ? "VWAP_R" : "POC_BRK_DN"
        tradeInstrument := "PUT"

signalStrength := math.min(signalStrength, 4)

// ============================================================================
// STOP LOSS & TAKE PROFIT
// ============================================================================

atrValue = ta.atr(atrPeriod)
slPoints = useATRSL ? atrValue * atrMultiplier : fixedSLPoints
tpPoints = slPoints * tpRRRatio

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// Entry conditions
longCondition = signal == 1 and signalStrength >= 2
shortCondition = signal == (-1) and signalStrength >= 2

// Calculate SL/TP levels
longSL = close - slPoints
longTP = close + tpPoints
shortSL = close + slPoints
shortTP = close - tpPoints

// Entry
if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment=signalType)
    strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if shortCondition and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment=signalType)
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// Trailing stop logic with stepped milestones
var int activeMilestone = -1
var float trailingStopLevel = na

// Reset milestone tracking on new position
if strategy.position_size == 0
    activeMilestone := -1
    trailingStopLevel := na

if trailMode != "None" and strategy.position_size != 0
    entryPrice = strategy.position_avg_price

    if strategy.position_size > 0
        // Long position trailing
        currentProfit = high - entryPrice  // Use high for milestone check

        // Check milestones in order (highest first for stepped)
        if trailMode == "Stepped"
            // Milestone 3
            if currentProfit >= slPoints * trail3ProfitMult and activeMilestone < 3
                trailingStopLevel := entryPrice + slPoints * trail3LockMult
                activeMilestone := 3
            // Milestone 2
            else if currentProfit >= slPoints * trail2ProfitMult and activeMilestone < 2
                trailingStopLevel := entryPrice + slPoints * trail2LockMult
                activeMilestone := 2
            // Milestone 1
            else if currentProfit >= slPoints * trail1ProfitMult and activeMilestone < 1
                trailingStopLevel := entryPrice + slPoints * trail1LockMult
                activeMilestone := 1
        else if trailMode == "Breakeven"
            // Simple breakeven at milestone 1
            if currentProfit >= slPoints * trail1ProfitMult and activeMilestone < 1
                trailingStopLevel := entryPrice + slPoints * trail1LockMult
                activeMilestone := 1

        // Update exit with trailing stop
        if not na(trailingStopLevel)
            strategy.exit("Long Exit", "Long", stop=trailingStopLevel, limit=longTP)

    else if strategy.position_size < 0
        // Short position trailing
        currentProfit = entryPrice - low  // Use low for milestone check

        // Check milestones in order (highest first for stepped)
        if trailMode == "Stepped"
            // Milestone 3
            if currentProfit >= slPoints * trail3ProfitMult and activeMilestone < 3
                trailingStopLevel := entryPrice - slPoints * trail3LockMult
                activeMilestone := 3
            // Milestone 2
            else if currentProfit >= slPoints * trail2ProfitMult and activeMilestone < 2
                trailingStopLevel := entryPrice - slPoints * trail2LockMult
                activeMilestone := 2
            // Milestone 1
            else if currentProfit >= slPoints * trail1ProfitMult and activeMilestone < 1
                trailingStopLevel := entryPrice - slPoints * trail1LockMult
                activeMilestone := 1
        else if trailMode == "Breakeven"
            // Simple breakeven at milestone 1
            if currentProfit >= slPoints * trail1ProfitMult and activeMilestone < 1
                trailingStopLevel := entryPrice - slPoints * trail1LockMult
                activeMilestone := 1

        // Update exit with trailing stop
        if not na(trailingStopLevel)
            strategy.exit("Short Exit", "Short", stop=trailingStopLevel, limit=shortTP)

// ============================================================================
// PLOTTING
// ============================================================================

plot(showVWAP ? vwapLine : na, "VWAP", colVWAP, 2)
plot(showVWAPBands ? vwapUpperInner : na, "VWAP Upper", color.new(colVWAP, 50), 1)
plot(showVWAPBands ? vwapLowerInner : na, "VWAP Lower", color.new(colVWAP, 50), 1)

plot(showSVPLevels ? poc : na, "POC", colPOC, 2, plot.style_stepline)
plot(showSVPLevels ? vah : na, "VAH", colVAH, 1, plot.style_stepline)
plot(showSVPLevels ? val_ : na, "VAL", colVAL, 1, plot.style_stepline)

// LVN Zones
bgcolor(showLVNZones and isLVN ? color.new(colLVN, 90) : na, title="LVN Zone")

// LVN Expansion highlighting
bgcolor(showLVNExpansion and inLVNExpansion and lvnDirection == 1 ? color.new(colBullish, 85) : na, title="LVN Expansion Up")
bgcolor(showLVNExpansion and inLVNExpansion and lvnDirection == (-1) ? color.new(colBearish, 85) : na, title="LVN Expansion Down")

// LVN Expansion success/failure markers
plotshape(showLVNExpansion and lvnExpansionSuccess and lvnDirection == 1, title="LVN Expansion Success Up", location=location.abovebar, style=shape.flag, size=size.small, color=colBullish, text="EXP")

plotshape(showLVNExpansion and lvnExpansionSuccess and lvnDirection == (-1), title="LVN Expansion Success Down", location=location.belowbar, style=shape.flag, size=size.small, color=colBearish, text="EXP")

// Trailing Stop Level
plot(strategy.position_size != 0 and not na(trailingStopLevel) ? trailingStopLevel : na, "Trailing SL", color.new(color.yellow, 0), 2, plot.style_linebr, title="Trailing Stop")

// Signal markers
plotshape(showSignals and signal == 1 and signalStrength >= 3, title="Strong Long", location=location.belowbar, style=shape.triangleup, size=size.normal, color=colBullish)

plotshape(showSignals and signal == (-1) and signalStrength >= 3, title="Strong Short", location=location.abovebar, style=shape.triangledown, size=size.normal, color=colBearish)

// ============================================================================
// INFO TABLE
// ============================================================================

var table infoTable = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(infoTable, 0, 0, "SVP+VWAP V2", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "w/ Trail SL", text_color=color.yellow, text_size=size.small)

    table.cell(infoTable, 0, 1, "POC", text_color=colPOC, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(poc, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 2, "VAH", text_color=colVAH, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(vah, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 3, "VAL", text_color=colVAL, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(val_, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 4, "VWAP", text_color=colVWAP, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(vwapLine, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 5, "POC Dir", text_color=color.white, text_size=size.small)
    pocText = pocMigrateDir == 1 ? "UP" : pocMigrateDir == (-1) ? "DOWN" : "FLAT"
    table.cell(infoTable, 1, 5, pocText, text_color=pocMigrateDir == 1 ? colBullish : pocMigrateDir == (-1) ? colBearish : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 6, "Signal", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, signalType != "" ? signalType : "-", text_color=signal == 1 ? colBullish : signal == (-1) ? colBearish : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 7, "Trade", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, tradeInstrument != "" ? tradeInstrument : "-", text_color=color.yellow, text_size=size.small)

    // Trailing SL info
    table.cell(infoTable, 0, 8, "Trail Mode", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, trailMode, text_color=color.yellow, text_size=size.small)

    table.cell(infoTable, 0, 9, "Trail SL", text_color=color.white, text_size=size.small)
    trailSLText = not na(trailingStopLevel) ? str.tostring(trailingStopLevel, "#.##") : "-"
    table.cell(infoTable, 1, 9, trailSLText, text_color=not na(trailingStopLevel) ? color.yellow : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 10, "Milestone", text_color=color.white, text_size=size.small)
    milestoneText = activeMilestone >= 1 ? str.tostring(activeMilestone) + "/3" : "-"
    table.cell(infoTable, 1, 10, milestoneText, text_color=activeMilestone >= 1 ? color.lime : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 11, "LVN Exp", text_color=colLVN, text_size=size.small)
    lvnExpText = inLVNExpansion ? (lvnDirection == 1 ? "LONG" : "SHORT") : "-"
    table.cell(infoTable, 1, 11, lvnExpText, text_color=inLVNExpansion ? color.yellow : color.gray, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(lvnBreakUp, title="LVN Expansion UP", message="LVN EXPANSION TRADE - BULLISH - {{ticker}} at {{close}}")
alertcondition(lvnBreakDown, title="LVN Expansion DOWN", message="LVN EXPANSION TRADE - BEARISH - {{ticker}} at {{close}}")
alertcondition(lvnExpansionSuccess, title="LVN Expansion Success", message="LVN Expansion completed successfully on {{ticker}}")
alertcondition(vahBreakout and pocMigrateUp, title="Strong Bullish Setup", message="VAH Breakout + POC Migrating UP - {{ticker}} - Trade CALL")
alertcondition(valBreakout and pocMigrateDown, title="Strong Bearish Setup", message="VAL Breakout + POC Migrating DOWN - {{ticker}} - Trade PUT")
